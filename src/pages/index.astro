---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { profile, experience, education, skills } from '../data/profile';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);

const pad = (n: number) => String(n).padStart(2, '0');
const [first, ...rest] = profile.name.split(' ');
const rev = new Date().toISOString().slice(0, 10);
---

<Base
  title={`${profile.name} · ${profile.handle}`}
  description={`${profile.name}: ${profile.bio[0]}`}
>
  <div class="sheet">
    <span class="crop tl" aria-hidden="true"></span>
    <span class="crop tr" aria-hidden="true"></span>
    <span class="crop bl" aria-hidden="true"></span>
    <span class="crop br" aria-hidden="true"></span>

    <main class="frame" data-draw>
      <header class="bar">
        <span>{profile.handle}.com · sheet 01/01</span>
        <nav aria-label="Sections">
          <a href="#about">About</a>
          <a href="#experience">Experience</a>
          <a href="#work">Work</a>
          <a href="#contact">Contact</a>
        </nav>
      </header>

      <section class="section hero" data-draw aria-labelledby="name">
        <span class="tag">[00] Index</span>
        <span class="note">{profile.location} · 40.71°N 74.00°W</span>
        <h1 id="name">{first}<br /><span class="outline">{rest.join(' ')}</span></h1>
        <div class="dim" aria-hidden="true">{profile.title.toLowerCase()}</div>
        <p class="lede">
          Software engineer, <em>now building in finance</em>. Studying quantitative
          finance in New York.
        </p>
      </section>

      <section class="section" data-draw id="about" aria-labelledby="about-h">
        <span class="tag" id="about-h">[01] About</span>
        <span class="note">scale 1:1</span>
        <div class="about">
          <div>
            {profile.bio.map((line) => <p>{line}</p>)}
          </div>
          <dl class="spec">
            <div><dt>Role</dt><dd>Software Engineer</dd></div>
            <div><dt>Exp.</dt><dd>3+ years in tech</dd></div>
            <div><dt>Study</dt><dd>MS Quantitative Finance</dd></div>
            <div><dt>School</dt><dd>Baruch College, Zicklin</dd></div>
            <div><dt>Based</dt><dd>{profile.location}</dd></div>
          </dl>
        </div>
      </section>

      <section class="section" data-draw id="experience" aria-labelledby="exp-h">
        <span class="tag" id="exp-h">[02] Experience</span>
        <span class="note">n = {pad(experience.length)}</span>
        <ol class="timeline">
          {
            experience.map((job) => (
              <li class="entry">
                <div class="when mono">
                  <span>{job.dates}</span>
                  <span>{job.place}</span>
                </div>
                <div>
                  <h3>{job.role}</h3>
                  <p class="where">{job.company}</p>
                  <ul class="points">
                    {job.points.map((pt) => <li>{pt}</li>)}
                  </ul>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="section" data-draw id="education" aria-labelledby="edu-h">
        <span class="tag" id="edu-h">[03] Education</span>
        <ol class="timeline">
          {
            education.map((ed) => (
              <li class="entry">
                <div class="when mono">
                  <span>{ed.dates}</span>
                  <span>{ed.place}</span>
                </div>
                <div>
                  <h3>{ed.degree}</h3>
                  <p class="where">{ed.school}</p>
                  <p class="detail">{ed.detail}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="section" data-draw id="work" aria-labelledby="work-h">
        <span class="tag" id="work-h">[04] Selected work</span>
        <span class="note">n = {pad(projects.length)}</span>
        <ul class="projects">
          {
            projects.map((p, i) => (
              <li class="card" data-draw>
                <div class="placeholder" aria-hidden="true">
                  <svg viewBox="0 0 160 90" preserveAspectRatio="none">
                    <line x1="0" y1="0" x2="160" y2="90" vector-effect="non-scaling-stroke" />
                    <line x1="160" y1="0" x2="0" y2="90" vector-effect="non-scaling-stroke" />
                  </svg>
                  <span class="idx">fig.{pad(i + 1)} · {p.data.year}</span>
                  <span class="label">{p.data.title}</span>
                </div>
                <div class="card-body">
                  <h3>{p.data.title}</h3>
                  <p>{p.data.summary}</p>
                  <ul class="chips">
                    {p.data.tech.map((t) => <li>{t}</li>)}
                  </ul>
                  <div class="card-links">
                    {p.data.repo && <a href={p.data.repo}>Source ↗</a>}
                    {p.data.link && <a href={p.data.link}>Live ↗</a>}
                  </div>
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="section" data-draw id="skills" aria-labelledby="skills-h">
        <span class="tag" id="skills-h">[05] Toolkit</span>
        <dl class="spec skills">
          {
            skills.map((s) => (
              <div>
                <dt>{s.group}</dt>
                <dd>
                  <ul class="chips">
                    {s.items.map((t) => <li>{t}</li>)}
                  </ul>
                </dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="section" data-draw id="contact" aria-labelledby="contact-h">
        <span class="tag" id="contact-h">[06] Contact</span>
        <ul class="contact">
          {profile.links.map((l) => <li><a href={l.href}>{l.label} ↗</a></li>)}
        </ul>
      </section>
    </main>
  </div>

  <footer class="foot">
    <span>© {new Date().getFullYear()} {profile.name}</span>
    <span>rev {rev} · built with Astro</span>
  </footer>
</Base>
